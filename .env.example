# Root .env.example
# Copy this file to .env and fill in real values for local development.
# Each app may also have its own .env file in apps/<app>/

# === Backend (apps/backend) ===
# Matches docker-compose.yml services (bookee user/pass/db)
DATABASE_URL=postgresql://bookee:bookee@localhost:5432/bookee?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
NODE_ENV=development

# Logging — LOG_LEVEL: trace|debug|info|warn|error|fatal, LOG_FORMAT: text|json
LOG_LEVEL=debug
LOG_FORMAT=text

# === Frontend (apps/operator-cms, apps/user-web) ===
VITE_API_URL=http://localhost:3000/api/v1
