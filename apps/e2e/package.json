{
  "name": "@bookee/e2e",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "e2e": "mkdir -p test-results && cucumber-js --config .cucumber.cjs",
    "e2e:headed": "HEADLESS=false cucumber-js --config .cucumber.cjs",
    "e2e:smoke": "cucumber-js --config .cucumber.cjs --tags @smoke",
    "e2e:auth": "cucumber-js --config .cucumber.cjs --tags @auth",
    "e2e:user": "cucumber-js --config .cucumber.cjs --tags \"@auth or @auth-register or @auth-login or @auth-profile or @health\"",
    "e2e:operator": "cucumber-js --config .cucumber.cjs --tags \"@operator-auth or @operator-stations or @operator-routes or @operator-seat-layouts or @operator-vehicles or @operator-trips or @operator-dashboard or @operator-shell\"",
    "e2e:all": "cucumber-js --config .cucumber.cjs",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium",
    "clean": "rm -rf test-results"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@bookee/config": "workspace:*",
    "@cucumber/cucumber": "^12.8.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.8.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
