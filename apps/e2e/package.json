{
  "name": "@bookee/e2e",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "mkdir -p test-results && cucumber-js --config .cucumber.cjs",
    "test:headed": "HEADLESS=false cucumber-js --config .cucumber.cjs",
    "test:smoke": "cucumber-js --config .cucumber.cjs --tags @smoke",
    "test:auth": "cucumber-js --config .cucumber.cjs --tags @auth",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium",
    "clean": "rm -rf test-results"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@bookee/config": "workspace:*",
    "@cucumber/cucumber": "^12.8.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.8.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
