DATABASE_URL=postgresql://bookee:bookee@localhost:5432/bookee?schema=public
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
NODE_ENV=development

# Logging
# LOG_LEVEL: trace | debug | info | warn | error | fatal
# LOG_FORMAT: text (pretty colorized) | json (newline-delimited JSON)
# Defaults: debug + text in dev, info + json in production.
LOG_LEVEL=debug
LOG_FORMAT=text
