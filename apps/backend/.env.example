DATABASE_URL=postgresql://bookee:bookee@localhost:5432/bookee?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
# 64-char hex string (32 bytes) — generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-64-hex-chars-from-openssl-rand-hex-32
PORT=3000
NODE_ENV=development

# Logging
# LOG_LEVEL: trace | debug | info | warn | error | fatal
# LOG_FORMAT: text (pretty colorized) | json (newline-delimited JSON)
# Defaults: debug + text in dev, info + json in production.
LOG_LEVEL=debug
LOG_FORMAT=text

# Momo payment provider
MOMO_PARTNER_CODE=MOMO_TEST
MOMO_ACCESS_KEY=MOMO_TEST_ACCESS
MOMO_SECRET_KEY=test-secret-32-chars-min-for-hmac
MOMO_API_BASE=https://test-payment.momo.vn
MOMO_RETURN_URL=http://localhost:5174/payment/return
MOMO_NOTIFY_URL=http://localhost:3000/api/v1/payments/webhooks/momo

# Stripe payment provider
STRIPE_API_KEY=sk_test_DEFER
STRIPE_WEBHOOK_SECRET=whsec_test_DEFER
