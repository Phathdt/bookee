{
  "name": "@bookee/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Bookee backend (NestJS)",
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "build": "nest build",
    "start": "bun dist/main.js",
    "start:prod": "bun dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "openapi:export": "EXPORT_OPENAPI=1 bun run scripts/export-openapi.ts",
    "db:generate": "echo '[backend] db:generate placeholder — wired after Prisma init'"
  },
  "dependencies": {
    "@bookee/shared-types": "workspace:*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^8",
    "js-yaml": "^4.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@bookee/config": "workspace:*",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "typescript": "^5.9.3"
  }
}
