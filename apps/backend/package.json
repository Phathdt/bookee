{
  "name": "@bookee/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Bookee backend (NestJS)",
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "build": "nest build",
    "start": "bun dist/src/main.js",
    "start:prod": "bun dist/src/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "openapi:export": "EXPORT_OPENAPI=1 bun run scripts/export-openapi.ts",
    "db:generate": "echo '[backend] db:generate placeholder — wired after Prisma init'"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.21",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/swagger": "^11",
    "js-yaml": "^4.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@bookee/config": "workspace:*",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.21",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.6",
    "source-map-support": "^0.5.21",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.6"
  }
}
